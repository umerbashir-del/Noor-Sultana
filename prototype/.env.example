ANTHROPIC_API_KEY=add-your-key-here
ANTHROPIC_MODEL=claude-haiku-5-5
# Local mode binds to 127.0.0.1. For a hosted single-server deployment set:
# NODE_ENV=production
# PUBLIC_ORIGIN=https://noor.your-domain.com
# NOOR_HOST=0.0.0.0
# PORT=4173
# NOOR_DATA_DIR=/app/data
# Production refuses to start without an HTTPS PUBLIC_ORIGIN. Configure HTTPS
# through the hosting proxy; the app then marks both cookies Secure.

# Per-browser visitor and overall UTC-day caps. Tune after measuring usage.
# NOOR_DAILY_CLAUDE_VISITOR_REQUESTS=30
# NOOR_DAILY_CLAUDE_GLOBAL_REQUESTS=500
# NOOR_DAILY_CLAUDE_VISITOR_TOKENS=30000
# NOOR_DAILY_CLAUDE_GLOBAL_TOKENS=300000
# NOOR_DAILY_SPEAK_VISITOR_REQUESTS=30
# NOOR_DAILY_SPEAK_GLOBAL_REQUESTS=500
# NOOR_DAILY_TRANSCRIBE_VISITOR_REQUESTS=30
# NOOR_DAILY_TRANSCRIBE_GLOBAL_REQUESTS=500
# NOOR_DAILY_VERIFICATION_VISITOR_REQUESTS=5
# NOOR_DAILY_VERIFICATION_GLOBAL_REQUESTS=100
# To enable verification and scheduled arrival emails, add a Resend API key and
# replace the sample with an address on a domain you have verified in Resend.
# RESEND_API_KEY=re_your_api_key_here
# NOOR_EMAIL_FROM=noor@your-domain.com
# Optional: persistent SQLite file (default: prototype/data/email.sqlite).
# NOOR_EMAIL_DB=C:\path\to\email.sqlite
# NOOR_USAGE_DB=C:\path\to\usage.sqlite
# Optional: set this if Chatterbox is installed in a different Python environment.
# CHATTERBOX_PYTHON=C:\\path\\to\\chatterbox\\Scripts\\python.exe
# ASR_PYTHON=C:\\path\\to\\faster-whisper\\Scripts\\python.exe
# NOOR_SKIP_VOICE_WARMUP=1
